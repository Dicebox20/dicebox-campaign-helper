{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@dicebox/core": ["packages/dicebox-core/src/index.ts"],
      "@dicebox/compiler": ["packages/dicebox-compiler/src/index.ts"],
      "@dicebox/bridge": ["packages/dicebox-bridge/src/index.ts"],
      "@dicebox/storage": ["packages/dicebox-storage/src/index.ts"],
      "@dicebox/scene": ["packages/dicebox-scene/src/index.ts"],
      "@dicebox/director": ["packages/dicebox-director/src/index.ts"],
      "@dicebox/codex-adapter": ["packages/dicebox-codex-adapter/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts"]
}
