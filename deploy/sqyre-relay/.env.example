# Public relay hostname served by Caddy. Use a real DNS name with HTTPS.
RELAY_DOMAIN=relay.example.com

DICEBOX_REMOTE_BRIDGE_HOST=0.0.0.0
DICEBOX_REMOTE_BRIDGE_PORT=8798
DICEBOX_REMOTE_PUBLIC_BASE_URL=https://relay.example.com
DICEBOX_REMOTE_TLS_TERMINATED=true
DICEBOX_REMOTE_AUTH_MODE=oidc
DICEBOX_REMOTE_OAUTH_ISSUER=https://auth.example.com
DICEBOX_REMOTE_OAUTH_AUDIENCE=dicebox-relay
DICEBOX_REMOTE_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
DICEBOX_REMOTE_OAUTH_SCOPE=dicebox.foundry

# Generate a long random value and place it here. Do not commit .env.
DICEBOX_FOUNDRY_CLIENT_TOKEN=replace-with-a-long-random-foundry-pairing-token

# Use the exact host shown in the Sqyre Foundry browser address bar.
DICEBOX_FOUNDRY_ORIGIN_HOSTS=www.sqyre.app

# MCP clients are authenticated by OIDC; keep browser CORS narrow if needed.
DICEBOX_REMOTE_CORS_ORIGIN=https://relay.example.com
